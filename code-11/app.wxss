page {
  --brand: #551645;
  --bg: #f5f5f7;
  --card: #ffffff;
  --text: #211112;
  --muted: #8c8c8c;
  --radius: 16rpx;
  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
}

.page { padding: 24rpx; }

.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--brand);
  margin-bottom: 12rpx;
}

.hint { color: var(--muted); font-size: 24rpx; line-height: 1.6; }

.btn {
  background: var(--brand);
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  margin: 12rpx 0;
}
.btn--ghost { background: #fff; color: var(--brand); border: 2rpx solid var(--brand); }

.kv { display: flex; justify-content: space-between; padding: 10rpx 0; font-size: 26rpx; }
.kv__k { color: var(--muted); }
.kv__v { font-family: Consolas, Menlo, monospace; }

.tbl { width: 100%; font-size: 24rpx; }
.tbl__row { display: flex; border-bottom: 2rpx solid #eee; padding: 12rpx 0; }
.tbl__row--head { font-weight: 600; color: var(--brand); }
.tbl__c { flex: 1; text-align: right; }
.tbl__c:first-child { flex: 2; text-align: left; }
