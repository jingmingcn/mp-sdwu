.opt { display: inline-block; margin-right: 24rpx; font-size: 24rpx; }
.m__head { display: flex; justify-content: space-between; font-size: 24rpx; color: #8c8c8c; }
.m__name { color: #551645; font-weight: 600; }
.m__content { font-size: 28rpx; margin: 12rpx 0; line-height: 1.6; }
.m__imgs { display: flex; flex-wrap: wrap; gap: 8rpx; }
.m__img { width: 200rpx; height: 200rpx; border-radius: 8rpx; background: #f2f2f2; }
.m__foot { display: flex; gap: 32rpx; margin-top: 12rpx; font-size: 24rpx; color: #8c8c8c; }
.m__act.is-on { color: #c0392b; }
