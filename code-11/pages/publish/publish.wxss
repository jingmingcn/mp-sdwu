.ta { width: 100%; min-height: 200rpx; font-size: 28rpx; line-height: 1.6; }
.counter { text-align: right; font-size: 22rpx; color: #8c8c8c; }
.imgs { display: flex; flex-wrap: wrap; gap: 12rpx; }
.img { position: relative; width: 180rpx; height: 180rpx; }
.img image { width: 100%; height: 100%; border-radius: 8rpx; }
.del {
  position: absolute; right: -8rpx; top: -8rpx;
  width: 40rpx; height: 40rpx; line-height: 36rpx; text-align: center;
  background: rgba(0,0,0,0.6); color: #fff; border-radius: 50%; font-size: 28rpx;
}
.add {
  width: 180rpx; height: 180rpx; line-height: 180rpx; text-align: center;
  border: 2rpx dashed #ccc; border-radius: 8rpx; color: #ccc; font-size: 48rpx;
}
