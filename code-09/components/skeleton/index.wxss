/* ⚠ 骨架屏的布局必须与真实内容一致，否则切换时会跳动 */
.sk-item { display: flex; gap: 16rpx; padding: 16rpx 0; border-bottom: 2rpx solid #f5f5f5; }
.sk-img { width: 160rpx; height: 160rpx; border-radius: 12rpx; flex: none; }
.sk-lines { flex: 1; padding-top: 12rpx; }
.sk-line { height: 28rpx; border-radius: 6rpx; margin-bottom: 16rpx; }
.w80 { width: 80%; }
.w50 { width: 50%; }
.sk-img, .sk-line {
  background: linear-gradient(90deg, #f2f2f2 25%, #e6e6e6 37%, #f2f2f2 63%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
}
@keyframes shimmer {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}
