.vl { width: 100%; }
.vl__row { overflow: hidden; border-bottom: 2rpx solid #f5f5f5; }
.vl__default { display: flex; gap: 16rpx; padding: 8rpx 0; }
.vl__img { width: 160rpx; height: 160rpx; border-radius: 12rpx; flex: none; background: #f2f2f2; }
.vl__body { flex: 1; overflow: hidden; }
.vl__title { font-size: 26rpx; }
.vl__price { font-size: 24rpx; color: #c0392b; margin-top: 8rpx; }
