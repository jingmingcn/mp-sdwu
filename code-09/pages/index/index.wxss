.opt { display: inline-block; margin-right: 24rpx; font-size: 24rpx; }
.row { display: flex; gap: 16rpx; padding: 8rpx 0; border-bottom: 2rpx solid #f5f5f5; height: 176rpx; }
.row__img { width: 160rpx; height: 160rpx; border-radius: 12rpx; flex: none; background: #f2f2f2; }
.row__body { flex: 1; overflow: hidden; }
.row__title { font-size: 26rpx; }
.row__price { font-size: 24rpx; color: #c0392b; margin-top: 8rpx; }
