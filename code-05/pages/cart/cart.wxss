.c { display: flex; align-items: center; gap: 12rpx; }
.c__ck { flex: none; }
.c__info { flex: 1; }
.c__title { font-size: 26rpx; }
.c__price { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.c__del { flex: none; color: #c0392b; font-size: 24rpx; padding: 0 8rpx; }
.bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; align-items: center; gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}
.bar__all { font-size: 24rpx; }
.bar__total { flex: 1; text-align: right; color: #c0392b; font-size: 28rpx; }
.bar__go { flex: none; }
