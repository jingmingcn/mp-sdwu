<view class="page">
  <view class="card">
    <view class="card__title">{{goods.title}}</view>
    <view class="kv"><text class="kv__k">价格</text><text class="kv__v">￥{{goods.price}}</text></view>
    <view class="kv"><text class="kv__k">来源</text><text class="kv__v">{{fromText}}</text></view>
  </view>

  <view class="card">
    <view class="card__title">分享</view>
    <button class="btn" open-type="share" data-id="{{goods.id}}" data-title="{{goods.title}}">
      转发给好友（带归因参数）
    </button>
    <view class="hint">
      朋友圈分享请点右上角「···」→「分享到朋友圈」。
      注意：onShareTimeline 只有 query 没有 path。
    </view>
  </view>

  <view class="card" wx:if="{{singlePage}}">
    <view class="card__title">单页模式已检测到</view>
    <view class="hint">
      页面栈长度 = {{stackLen}}。
      单页模式下没有页面栈，navigateTo 受限，应引导「前往小程序查看更多」。
    </view>
  </view>

  <view class="card">
    <button class="btn btn--ghost" bindtap="buy">立即购买（单页模式下观察行为）</button>
  </view>
</view>
